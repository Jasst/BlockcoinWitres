+
+/* ===== v4.0 Visual Polish (Modern Neutral Gray) ===== */
+
+/* Единый тон поверх стеклянных панелей — спокойный, без пересветов */
+.chat-panel-header,
+.conversations-header {
+  background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0)) , var(--bg-secondary);
+  backdrop-filter: blur(14px);
+  -webkit-backdrop-filter: blur(14px);
+}
+
+/* Аккуратные скроллбары */
+* { scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.14) transparent; }
+::-webkit-scrollbar { width: 8px; height: 8px; }
+::-webkit-scrollbar-track { background: transparent; }
+::-webkit-scrollbar-thumb {
+  background: rgba(255, 255, 255, 0.12);
+  border-radius: 8px;
+  border: 2px solid transparent;
+  background-clip: padding-box;
+}
+::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.22); background-clip: padding-box; }
+
+/* Фокус — тонкий светлый ring вместо цветного свечения */
+.input:focus, .search-input:focus, .input-wrapper textarea:focus {
+  outline: none;
+  border-color: var(--border-focus);
+  box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.06);
+}
+.btn-primary-oval:focus-visible, .btn-oval:focus-visible, .btn-icon-oval:focus-visible,
+.bottom-nav-item:focus-visible, .ai-tool-btn:focus-visible {
+  outline: 2px solid var(--accent-hover);
+  outline-offset: 2px;
+}
+
+/* Отключаем «прыжки» hover-трансформаций для кнопок чата — только подсветка */
+.input-area .btn-icon-oval:hover,
+#sendButton:hover, #aiSendBtn:hover { transform: none; box-shadow: var(--shadow-sm); }
+.input-area .btn-icon-oval:active,
+#sendButton:active, #aiSendBtn:active { transform: scale(0.94); }
+
+/* Панель бесед — разделение тонкой линией, а не «стеклом» */
+.conversations-panel { border-right: 1px solid var(--border-color); }
+.chat-layout { background: var(--bg-primary); }
+
+/* Карточки списков — ровный фон поверхности, мягкий hover без сдвига */
+.conversation-item, .list-item, .group-card, .profile-card {
+  transition: background var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
+}
+.conversation-item:hover { transform: none; background: var(--bg-hover); border-color: var(--glass-border); }
+.list-item:hover, .group-card:hover { border-color: var(--glass-border-light); box-shadow: var(--shadow-sm); }
+
+/* Пузыри принятых сообщений — чуть более «матовые», читаемые */
+.message .content {
+  background: var(--bg-surface);
+  border: 1px solid var(--border-color);
+  box-shadow: none;
+}
+.message:hover .content { box-shadow: var(--shadow-sm); transform: none; }
+.message.sent:hover .content { box-shadow: var(--shadow-md); }
+
+/* Тумблер AI-инструментов — нейтральная активная подсветка */
+.ai-tool-btn[data-active="true"] {
+  background: rgba(255, 255, 255, 0.10);
+  color: var(--text-primary);
+  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.14);
+}
+
+/* Нижняя навигация — активный пункт: светлая «таблетка» */
+.bottom-nav-item.active {
+  background: rgba(255, 255, 255, 0.08);
+  color: var(--text-primary);
+}
+.bottom-nav-item.active .nav-icon svg { stroke: var(--text-primary); }
+
+/* Статусы/бейджи — приглушённые полупрозрачные плашки */
+.status-badge { border: 1px solid transparent; }
+.status-success { background: rgba(76, 195, 138, 0.12); color: var(--success-color); border-color: rgba(76, 195, 138, 0.25); }
+.status-warning { background: rgba(224, 164, 88, 0.12); color: var(--warning-color); border-color: rgba(224, 164, 88, 0.25); }
+
+/* Модалки — глубже тень, плотнее фон */
+.modal-overlay { background: rgba(5, 6, 8, 0.72); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
+.modal, .call-modal { background: var(--bg-surface); border: 1px solid var(--glass-border); }
+
+/* Код в markdown — контрастная, но нейтральная подложка */
+.markdown-body pre { background: #121317; }
+.markdown-body code:not(pre code) { background: rgba(255, 255, 255, 0.07); border-color: rgba(255,255,255,0.10); }
+
+/* Светлая тема — те же принципы: нейтральный серый, без фиолетового маржина */
+body.light-theme .message .content { background: #ffffff; border-color: rgba(36,38,44,0.08); }
+body.light-theme .conversation-item { background: #ffffff; border: 1px solid rgba(36,38,44,0.07); }
+body.light-theme .conversation-item:hover { background: #f0f1f4; }
+body.light-theme .conversation-item.active { background: #e9eaee; border-color: rgba(36,38,44,0.16); }
+body.light-theme .conversations-panel { background: #fafbfc; border-right: 1px solid rgba(36,38,44,0.08); }
+body.light-theme .chat-panel { background: #f3f4f6; }
+body.light-theme .chat-panel-header, body.light-theme .conversations-header { background: rgba(255,255,255,0.9); }
+body.light-theme .bottom-nav { background: rgba(255,255,255,0.92); border: 1px solid rgba(36,38,44,0.08); }
+body.light-theme .bottom-nav-item.active { background: rgba(36,38,44,0.07); color: #1b1d21; }
+body.light-theme .bottom-nav-item.active .nav-icon svg { stroke: #1b1d21; }
+body.light-theme .input:focus, body.light-theme .search-input:focus { box-shadow: 0 0 0 3px rgba(36,38,44,0.06); }
+body.light-theme .modal, body.light-theme .call-modal { background: #ffffff; }
+body.light-theme .markdown-body pre { background: #17181c; } /* код остаётся тёмным — как в AI-продуктах */
+body.light-theme ::-webkit-scrollbar-thumb { background: rgba(36,38,44,0.18); background-clip: padding-box; }
+body.light-theme ::-webkit-scrollbar-thumb:hover { background: rgba(36,38,44,0.3); background-clip: padding-box; }
+
+/* ===== v4.0 PNG-иконки в светлой теме (надёжно, без inline-стилей) ===== */
+body.light-theme .btn-icon-oval img[src*="/icons/"],
+body.light-theme .ai-tool-btn img[src*="/icons/"],
+body.light-theme .bottom-nav-item img[src*="/icons/"] {
+  filter: invert(0.12) sepia(0) saturate(0.6) brightness(0.55);
+}
+
+/* Иконки в овальных кнопках — по центру, без лишних отступов */
+.btn-icon-oval img { width: 20px; height: 20px; display: block; }
+
+/* Область ввода: аккуратная внутренняя «капсула» */
+.input-area { border-color: var(--glass-border-light); }
+.input-wrapper textarea { padding: 9px 4px; }
+
+/* Плавающая навигация — чуть плотнее фон для читаемости */
+.bottom-nav { background: rgba(23, 24, 28, 0.88); }
+body.light-theme .bottom-nav { background: rgba(255, 255, 255, 0.94); }
+
+/* Отправка AI: кнопка стоп — нейтрально-красная, без неона */
+.stop-btn { box-shadow: 0 4px 14px rgba(229, 84, 79, 0.35); }
+
+/* ============================================================
+   Контекстные меню (правый клик / долгое нажатие) — ctx-menu.js
+   ============================================================ */
+.ctx-menu {
+  position: fixed;
+  z-index: 10000;
+  min-width: 210px;
+  max-width: 300px;
+  padding: 6px;
+  background: var(--bg-surface, #1a1c21);
+  border: 1px solid var(--border-color, rgba(255,255,255,0.09));
+  border-radius: 14px;
+  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45), 0 2px 8px rgba(0, 0, 0, 0.3);
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  opacity: 0;
+  transform: scale(0.96) translateY(-4px);
+  transform-origin: top left;
+  transition: opacity 0.14s ease, transform 0.14s ease;
+  -webkit-backdrop-filter: blur(14px);
+  backdrop-filter: blur(14px);
+}
+.ctx-menu.ctx-visible {
+  opacity: 1;
+  transform: scale(1) translateY(0);
+}
+.ctx-item {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  width: 100%;
+  padding: 9px 11px;
+  border: none;
+  border-radius: 9px;
+  background: transparent;
+  color: var(--text-primary, #eceef1);
+  font-size: 14px;
+  font-family: inherit;
+  line-height: 1.3;
+  text-align: left;
+  cursor: pointer;
+  transition: background 0.12s ease, color 0.12s ease;
+}
+.ctx-item:hover,
+.ctx-item:focus-visible {
+  background: rgba(255, 255, 255, 0.07);
+  outline: none;
+}
+.ctx-item:active {
+  background: rgba(255, 255, 255, 0.11);
+}
+.ctx-item .ctx-icon {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 18px;
+  height: 18px;
+  flex: 0 0 18px;
+  color: var(--text-muted, #a6abb5);
+}
+.ctx-item .ctx-icon svg {
+  width: 18px;
+  height: 18px;
+  stroke: currentColor;
+  fill: none;
+  stroke-width: 1.8;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+  display: block;
+}
+/* Защита от «двойных» иконок: если в пункт меню по ошибке попал PNG-иконка,
+   скрываем <img> — визуально остаётся только одна SVG-иконка */
+.ctx-item .ctx-icon img {
+  display: none !important;
+}
+.ctx-item.danger {
+  color: #e5544f;
+}
+.ctx-item.danger .ctx-icon {
+  color: #e5544f;
+}
+.ctx-item.danger:hover,
+.ctx-item.danger:focus-visible {
+  background: rgba(229, 84, 79, 0.12);
+}
+.ctx-separator {
+  height: 1px;
+  margin: 4px 8px;
+  background: var(--border-color, rgba(255,255,255,0.09));
+}
+/* Подсветка элемента, на котором открыто меню */
+.ctx-press {
+  background: rgba(255, 255, 255, 0.06) !important;
+  transition: background 0.1s ease;
+}
+.ctx-target-active {
+  background: rgba(255, 255, 255, 0.07);
+  border-radius: 12px;
+}
+/* Светлая тема */
+body.light-theme .ctx-menu {
+  background: #ffffff;
+  border-color: rgba(36, 38, 44, 0.12);
+  box-shadow: 0 12px 34px rgba(0, 0, 0, 0.14), 0 2px 6px rgba(0, 0, 0, 0.08);
+}
+body.light-theme .ctx-item {
+  color: #24262c;
+}
+body.light-theme .ctx-item:hover,
+body.light-theme .ctx-item:focus-visible {
+  background: rgba(36, 38, 44, 0.06);
+}
+body.light-theme .ctx-item:active {
+  background: rgba(36, 38, 44, 0.1);
+}
+body.light-theme .ctx-item .ctx-icon {
+  color: #6b7280;
+}
+body.light-theme .ctx-item.danger,
+body.light-theme .ctx-item.danger .ctx-icon {
+  color: #d43f3a;
+}
+body.light-theme .ctx-item.danger:hover {
+  background: rgba(212, 63, 58, 0.08);
+}
+body.light-theme .ctx-separator {
+  background: rgba(36, 38, 44, 0.1);
+}
+body.light-theme .ctx-press,
+body.light-theme .ctx-target-active {
+  background: rgba(36, 38, 44, 0.06) !important;
+}
