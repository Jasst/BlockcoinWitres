# Database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost/bichat_db

# Security (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here-min-32-characters-long

# Blockchain settings
POW_DIFFICULTY=6
POW_MAX_ITERATIONS=100000000
TRANSFER_FEE=50000
MESSAGE_FEE=100
AIRDROP_AMOUNT=1000
MIN_STAKE_AMOUNT=10000000
STAKE_LOCK_BLOCKS=100
BLOCK_REWARD=100000
STAKING_FEE_FROM_BLOCK_REWARD=0.1
ENABLE_MINING=1
ENABLE_STAKING=1

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_MESSAGE_PER_MINUTE=30
RATE_LIMIT_API_PER_MINUTE=120

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,https://blockchat.ru

# Upload limits (bytes)
MAX_UPLOAD_SIZE=16777216
MAX_MESSAGE_PAYLOAD_SIZE=65536
MAX_ENCRYPTED_FILE_SIZE=5242880
MAX_AUDIO_SIZE=2097152

# Session & timeouts
SESSION_LIFETIME=31536000
ONLINE_TIMEOUT_SECONDS=60
MINING_CHALLENGE_TTL=60

# Logging
LOG_LEVEL=INFO

# AI Image Generation (Easy Diffusion)
EASYDIFFUSION_URL=http://localhost:9000
EASYDIFFUSION_TIMEOUT=160
EASYDIFFUSION_STEPS=20
EASYDIFFUSION_WIDTH=512
EASYDIFFUSION_HEIGHT=512

# Push Notifications (VAPID)
# Generate with: web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:your-email@example.com

# WebRTC / TURN (calls)
TURN_ENABLED=1
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=turn:your-domain.com:3478
TURN_STATIC_AUTH_SECRET=your-turn-secret-here
TURN_USERNAME=
TURN_PASSWORD=
TURN_REALM=blockchat.ru
TURN_CREDENTIAL_TTL=86400

# Environment
FLASK_ENV=development
