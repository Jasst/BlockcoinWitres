```gitignore
# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Dependencies
.venv/
venv/
env/
requirements.txt.bak

# Logs
*.log

# Environment variables
.env
.env.local
*.env

# Editors
.vscode/
.idea/
*.swp
*.swo

# Build artifacts
dist/
build/
*.egg-info/
.coverage
htmlcov/
.mypy_cache/
.pytest_cache/
```